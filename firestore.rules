rules_version = '2';

// Acesso sem login: só quem tem o link da equipe (com a chave) lê e grava os pedidos.
// Troque CHAVE_DA_EQUIPE pela chave do link (o texto depois de "#k=").
// A chave verdadeira NÃO deve ser salva neste repositório, porque ele é público.
service cloud.firestore {
  match /databases/{database}/documents {
    match /equipes/{chave}/{colecao}/{doc} {
      allow read, write: if chave == 'CHAVE_DA_EQUIPE';
    }
  }
}
